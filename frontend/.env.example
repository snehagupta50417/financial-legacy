# Copy to .env.local for development. In Cloud Run, set these as env vars / Secret Manager secrets.

# SQLite for v0 (reseeded for the demo). Cloud Run: file:/tmp/finlegacy.db
DATABASE_URL="file:./db/dev.db"

# Gemini: set GEMINI_API_KEY (AI Studio), OR leave it empty and set GOOGLE_CLOUD_PROJECT
# to use Vertex AI with the Cloud Run service account. With neither, AI features
# degrade gracefully (rule-based intake, 503 on drafts/Q&A).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
# Tried in order on overload (503/429) or a retired model (404)
GEMINI_FALLBACK_MODELS="gemini-3.5-flash,gemini-flash-lite-latest"
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"
AI_TIMEOUT_MS="45000"

# Discovery connectors: mock | real (v0: all mock except scan)
CONNECTOR_MODE_EMAIL="mock"
CONNECTOR_MODE_TAX_RECORD="mock"
CONNECTOR_MODE_SMS="mock"
CONNECTOR_MODE_REGISTRY="mock"
CONNECTOR_MODE_SCAN="real"

# Verify console access (x-console-key header)
CONSOLE_KEY=""

# Allows /api/admin/reset in production
DEMO_MODE="false"

MAX_UPLOAD_MB="8"
RATE_LIMIT_AI_PER_MINUTE="20"
LOG_LEVEL="info"
