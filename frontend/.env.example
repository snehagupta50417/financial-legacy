# Copy to .env.local for development. In Cloud Run, set these as env vars / Secret Manager secrets.

# SQLite for v0 (reseeded for the demo). Cloud Run: file:/tmp/finlegacy.db
DATABASE_URL="file:./db/dev.db"

# Gemini (AI Studio key) — or configure Vertex AI instead
GEMINI_API_KEY=""

# Discovery connectors: mock | real (v0: all mock except scan)
CONNECTOR_MODE_EMAIL="mock"
CONNECTOR_MODE_TAX_RECORD="mock"
CONNECTOR_MODE_SMS="mock"
CONNECTOR_MODE_REGISTRY="mock"
CONNECTOR_MODE_SCAN="real"

# Verify console access (x-console-key header)
CONSOLE_KEY=""

# Allows /api/admin/reset in production
DEMO_MODE="false"

MAX_UPLOAD_MB="8"
RATE_LIMIT_AI_PER_MINUTE="20"
LOG_LEVEL="info"
