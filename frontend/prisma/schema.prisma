generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Demo-grade identity: a client-generated session key. All records are scoped
// by sessionId so one visitor can never read another visitor's cases.
model Session {
  id        String   @id
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  cases     LegacyCase[]
  consents  ConsentRecord[]
  messages  IntakeMessage[]
  claimants Claimant[]
}

model LegacyCase {
  id              String   @id @default(cuid())
  sessionId       String
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  caseType        String // living_individual | family_death | nominee_heir | estate_planning | rejected_claim | caregiver | nri_cross_border | general
  assetHolderName String?
  relationship    String?
  holderLiving    Boolean?
  jurisdiction    String   @default("India")
  summary         String
  stage           String   @default("understanding") // understanding | discovery | documentation | action | resolution
  progress        Float    @default(0)
  nextBestAction  String?
  scenarioLabel   String?
  confidence      Float?
  confirmedFacts  String? // JSON array
  assumptions     String? // JSON array
  isDemo          Boolean  @default(false)
  demoKey         String? // demo-a | demo-b | demo-c | demo-reclaim
  // Trust gates (plan §3). Enforced in src/server/core/gate-engine.ts
  gateReached     String   @default("G0") // G0 | G1 | G2 | G3 | G4
  frozenReason    String?
  deceasedPersonId String?
  deceasedPerson  DeceasedPerson? @relation(fields: [deceasedPersonId], references: [id])
  linkedCaseId    String?
  assets          AssetRecord[]
  claimants       Claimant[]
  proofs          Proof[]
  consents        ConsentRecord[]
  qaMessages      QaMessage[]
  documents       DocumentRecord[]
  tasks           JourneyTask[]
  events          CaseEvent[]
  chunks          KnowledgeChunk[]
  claims          Claim[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AssetRecord {
  id                String   @id @default(cuid())
  caseId            String
  case              LegacyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  category          String // bank_deposit | bank_account | insurance | mutual_fund | shares | provident_fund | other | unknown
  institution       String
  maskedRef         String?
  holderName        String?
  evidence          String?
  sourceDocumentId  String?
  discoveryStatus   String   @default("possible") // possible | confirmed | dismissed
  // The one status shown to people (PRD FL-07). Set only by rules/evidence.ts.
  evidenceStatus    String   @default("self_declared") // self_declared | potential_match | document_backed | institution_verified
  // Duplicate review (FL-08): same institution + category + last-4 is a candidate, never merged automatically.
  duplicateOfId     String?
  duplicateState    String?  // candidate | distinct | merged
  observations      Observation[]
  // Nominee and joint-holder information (FL-09); "unknown" until someone tells us or a document shows it.
  nomineeStatus     String   @default("unknown") // recorded | none | unknown
  jointHolderStatus String   @default("unknown") // surviving | none | unknown
  claims            Claim[]
  confidence        Float    @default(0.5)
  notes             String?
  entitled          Boolean  @default(false) // G4 for this asset
  valueBand         String?  // e.g. "₹1–5 lakh"
  last4             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DocumentRecord {
  id               String   @id @default(cuid())
  caseId           String
  case             LegacyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  category         String   @default("other") // bank_statement | policy_document | death_certificate | will | claim_letter | receipt | other
  fileName         String
  fileType         String
  sizeLabel        String?
  extractionStatus String   @default("pending") // pending | processing | extracted | failed
  extractionNote   String?
  rawText          String?
  extractedFields  String? // JSON object
  userVerified     Boolean  @default(false)
  isSynthetic      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  chunks           KnowledgeChunk[]
  fields           DocumentField[]
}

model JourneyTask {
  id               String   @id @default(cuid())
  caseId           String
  case             LegacyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title            String
  instructions     String
  rationale        String?
  institution      String?
  assetCategory    String?
  officialUrl      String?
  officialName     String?
  integrationType  String   @default("guided_workflow") // guided_workflow | official_website | public_api
  requiredDocs     String? // JSON array
  missingInfo      String? // JSON array
  dependencies     String? // JSON array of task ids
  status           String   @default("ready") // not_started | ready | in_progress | waiting_institution | needs_expert | completed
  priority         Int      @default(50)
  isNextBest       Boolean  @default(false)
  sortOrder        Int      @default(0)
  completionEvidence String?
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CaseEvent {
  id          String   @id @default(cuid())
  caseId      String
  case        LegacyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  eventType   String // created | document | asset | task | ai | consent | gate | claim | discovery
  description String
  actor       String   @default("ai") // ai | user | system | staff
  refId       String?
  createdAt   DateTime @default(now())
}

model ConsentRecord {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  caseId    String?
  case      LegacyCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  source    String?  // connector id: email | tax_record | sms | statement | registry | scan
  purpose   String
  scope     String   @default("")
  status    String   @default("granted") // granted | revoked
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
}

model IntakeMessage {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  caseId    String?
  role      String // user | assistant
  content   String
  meta      String? // JSON: classification, follow-up questions, suggestions
  createdAt DateTime @default(now())
}

// ─── Trust gates: people, proofs and the deceased person (LLD §7) ─────────

model DeceasedPerson {
  id               String   @id @default(cuid())
  name             String
  nameVariants     String   @default("[]") // JSON array
  dob              String?  // YYYY-MM-DD
  panHash          String?  // HMAC of PAN; the PAN itself is never stored
  dateOfDeath      String?  // YYYY-MM-DD
  deathProofStatus String   @default("pending") // pending | verified | needs_review
  cases            LegacyCase[]
  createdAt        DateTime @default(now())

  @@index([panHash])
}

model Claimant {
  id                 String   @id @default(cuid())
  caseId             String
  case               LegacyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sessionId          String
  session            Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fullName           String?
  relationship       String?
  role               String   @default("lead") // lead | co_heir
  identityStatus     String   @default("pending") // pending | verified | needs_review
  relationshipStatus String   @default("pending") // pending | verified | needs_review | not_required
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Proof {
  id            String   @id @default(cuid())
  caseId        String
  case          LegacyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind          String   // identity | death | relationship | entitlement
  assetId       String?
  provider      String   // mock_digilocker | mock_passport_selfie | gemini_scan | mock_registry | demo_seed ...
  status        String   // verified | needs_review | failed
  matchedFields String   @default("{}") // JSON: field → { expected, found, match }
  note          String?
  createdAt     DateTime @default(now())
}

// One claim per holding (PRD FL-12–FL-16, FL-36, FL-37; LLD §11). The family submits it themselves.
model Claim {
  id                 String      @id @default(cuid())
  caseId             String
  case               LegacyCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assetId            String
  asset              AssetRecord @relation(fields: [assetId], references: [id], onDelete: Cascade)
  status             String      @default("draft") // see rules/claim-lifecycle.ts
  path               String? // nominee | joint | quick | simplified | succession | no_nominee — chosen by rules/claim-path.ts
  reviewReason       String? // why a person must look at it instead of a path being chosen
  situation          String      @default("{}") // JSON answers: nominee, claimant relationship, amount band, bank type, dispute
  procedureId        String?
  procedureVersion   String?
  procedureCheckedOn String?
  checklist          String      @default("{}") // JSON: item id → { state: missing | have | linked, documentId? }
  declarations       String      @default("[]") // JSON array of accepted declaration ids
  waitingOn          String? // family | institution | financial_legacy
  dueDate            String? // YYYY-MM-DD for the open item
  institutionRef     String?
  submittedAt        DateTime?
  submissionChannel  String?
  receiptRef         String?
  outcome            String? // settled | transferred | partially_settled | rejected | unresolved_dispute
  outcomeAmount      String? // decimal string
  outcomeDate        String?
  outcomeNote        String?
  outcomeDocumentId  String?
  remainderTracked   Boolean     @default(false)
  packs              ClaimPack[]
  events             ClaimEvent[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([caseId])
}

// A frozen version of a claim pack. A new version is saved whenever the content changes;
// earlier versions are kept (FL-37). contentHash binds approvals to exactly these bytes.
model ClaimPack {
  id          String     @id @default(cuid())
  claimId     String
  claim       Claim      @relation(fields: [claimId], references: [id], onDelete: Cascade)
  version     Int
  contentHash String
  content     String // JSON: procedure, path, items, pre-filled fields, declarations
  status      String     @default("draft") // draft | ready | superseded
  approvals   Approval[]
  createdAt   DateTime   @default(now())

  @@unique([claimId, version])
}

// Approval of exactly what will leave the product (FL-14): bound to one pack hash,
// recipient, channel and purpose; expires; invalidated by any change.
model Approval {
  id          String    @id @default(cuid())
  packId      String
  pack        ClaimPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  contentHash String
  recipient   String
  channel     String
  purpose     String
  approvedBy  String
  state       String    @default("active") // active | used | expired | invalidated
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}

// Claim timeline: every step, request and outcome, kept for good (FL-15, FL-37).
model ClaimEvent {
  id        String   @id @default(cuid())
  claimId   String
  claim     Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  kind      String
  note      String
  actor     String // family | system | institution (as recorded by the family)
  createdAt DateTime @default(now())
}

model QaMessage {
  id        String   @id @default(cuid())
  caseId    String
  case      LegacyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  createdAt DateTime @default(now())
}

// Search index for the case assistant (RAG). "library" rows are the official
// procedure library (no case); "case" rows are chunks of a case's redacted
// document text. Vectors are JSON in SQLite; pgvector on Cloud SQL later.
model KnowledgeChunk {
  id             String          @id @default(cuid())
  scope          String // library | case
  caseId         String?
  case           LegacyCase?     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  documentId     String?
  document       DocumentRecord? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourceId       String // library passage id or document id
  ordinal        Int             @default(0)
  title          String
  url            String?
  checkedOn      String?
  text           String
  contentHash    String
  embedding      String? // JSON number[] (unit length)
  embeddingModel String?
  createdAt      DateTime        @default(now())

  @@index([scope, caseId])
  @@index([documentId])
}

// One value read from a document, and the person's decision on it (PRD FL-06, FL-26).
// extractedFields on DocumentRecord keeps the original AI proposal; this is the reviewed truth.
model DocumentField {
  id            String         @id @default(cuid())
  documentId    String
  document      DocumentRecord @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ordinal       Int
  label         String
  proposedValue String
  value         String // current value: proposedValue, or the correction
  confidence    Float          @default(0.5)
  sourceExcerpt String         @default("")
  critical      Boolean        @default(false)
  state         String         @default("proposed") // proposed | accepted | corrected | rejected
  reason        String?
  reviewedAt    DateTime?
  reviewedBy    String? // session id until real sign-in (B3)
  history       FieldReviewEvent[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([documentId, ordinal])
}

// Append-only history of every review decision: who, when, why, and the previous version.
model FieldReviewEvent {
  id        String        @id @default(cuid())
  fieldId   String
  field     DocumentField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fromState String
  toState   String
  fromValue String
  toValue   String
  reason    String?
  actor     String
  createdAt DateTime      @default(now())
}

// A dated amount for a holding (PRD FL-09, FL-28, FL-29). Append-only: a newer or
// corrected amount supersedes an older one; nothing is overwritten or deleted.
model Observation {
  id               String      @id @default(cuid())
  assetId          String
  asset            AssetRecord @relation(fields: [assetId], references: [id], onDelete: Cascade)
  amount           String // decimal string, e.g. "125728.00" — never a float
  currency         String      @default("INR")
  amountType       String // cash_balance | current_value | sum_assured | principal | maturity_value | premium | units | other
  asOfDate         String? // YYYY-MM-DD; null = undated (never counted in totals)
  label            String // what the document called it, e.g. "Closing balance"
  sourceDocumentId String?
  sourceFieldId    String?
  reviewedAt       DateTime?
  reviewedBy       String?
  supersededAt     DateTime?
  createdAt        DateTime    @default(now())

  @@index([assetId])
}
