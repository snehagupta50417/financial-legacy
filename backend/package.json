{
  "name": "keeper-backend",
  "version": "0.3.0",
  "private": true,
  "description": "Keeper API: trust gates, masking, OCR, RAG, claims and the AI agent. Runs as its own service.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "prisma generate",
    "start": "prisma db push --skip-generate && tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@hono/node-server": "^1.14.0",
    "@napi-rs/canvas": "^0.1.100",
    "@prisma/client": "^6.11.1",
    "hono": "^4.7.0",
    "pdf-lib": "1.17.1",
    "prisma": "^6.11.1",
    "tesseract.js": "^6.0.1",
    "tsx": "^4.19.0",
    "unpdf": "^1.9.0",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
